# Public browser configuration only. NEVER use a service_role/secret key here.
# Public local API address; the launcher generates private fixture values separately.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Only a publishable key or supported public legacy key belongs here.
# An empty value is a template, not working backend access.
VITE_SUPABASE_PUBLISHABLE_KEY=
