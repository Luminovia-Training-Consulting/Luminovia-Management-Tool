# Public browser configuration only. NEVER use a service_role/secret key here.
# Öffentliche lokale API-Adresse; der Launcher erzeugt private Testwerte separat.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Nur Publishable-Key beziehungsweise zulässiger öffentlicher Legacy-Key.
# Ein leerer Wert ist eine Vorlage und kein funktionsfähiger Backendzugang.
VITE_SUPABASE_PUBLISHABLE_KEY=
