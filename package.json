{
  "name": "luminovia-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start:local": "./portal start",
    "test:all": "./portal test",
    "dev": "vite --host 127.0.0.1",
