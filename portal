#!/usr/bin/env bash
# Public Linux entry point for the local portal runtime.
# Check Node before startup; exec forwards signals and exit status to the CLI.
set -euo pipefail
cd "$(dirname "$0")"
if ! command -v node >/dev/null 2>&1; then
  echo 'Node.js >=22.12 und Docker werden benötigt. Siehe README.md.' >&2
  exit 1
fi
if ! node -e 'const [major,minor]=process.versions.node.split(".").map(Number);process.exit(major>22||(major===22&&minor>=12)?0:1)'; then
  echo 'Node.js >=22.12 ist erforderlich; bitte Node.js aktualisieren.' >&2
  exit 1
fi
exec node scripts/runtime-cli.mjs "$@"
