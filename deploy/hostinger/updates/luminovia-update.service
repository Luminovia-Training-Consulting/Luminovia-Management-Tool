[Unit]
Description=Install a verified Luminovia CMS release from GitHub
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/luminovia-portal
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 0 /run/lock/luminovia-maintenance.lock /usr/bin/python3 /opt/luminovia-portal/control/updater.py --once
TimeoutStartSec=25min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/luminovia-portal /run/lock
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal

