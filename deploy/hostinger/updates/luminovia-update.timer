# Poll for an immutable current-main release. The updater decides eligibility from package, migration, backup, state and maintenance checks.
[Unit]
Description=Check for verified CMS updates every five minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
RandomizedDelaySec=20s
Unit=luminovia-update.service

[Install]
WantedBy=timers.target
