# Development ingress serves the static app and explicitly allowed backend routes. Private API responses are not cached; the maintenance marker fences backend requests before data changes.
{
	admin off
	# Access logging stays disabled. Runtime/error logs must also omit query
	# capabilities and invitation/recovery values during upstream failures.
	log default {
		exclude http.log.error
		format filter {
			wrap json
			fields {
				request>uri regexp "[?].*$" ""
				request>headers delete
				uri regexp "[?].*$" ""
				url regexp "[?].*$" ""
			}
		}
	}
	# Caddy emits errors processed by handle_errors at debug level, including
	# upstream failures that pass through the Academy asset fallback matcher.
	log portal_http_errors {
		include http.log.error
		level DEBUG
		format filter {
			wrap json
			fields {
				request>uri regexp "[?].*$" ""
				request>headers delete
				uri regexp "[?].*$" ""
				url regexp "[?].*$" ""
			}
		}
	}
}
(portal_static_pwa) {
}

(portal_standard_errors) {
}

(portal_no_reset) {
	handle /__portal/hosted-reset {
		header Cache-Control no-store
		respond 404
	}
}

(cms_hosted_reset) {
	handle /__portal/hosted-reset {
		route {
			header >Cache-Control "no-store"
			@discovery method GET
			reverse_proxy @discovery unix//srv/.platform-reset.sock {
				header_up -Cookie
				header_up -Authorization
				header_up -Referer
				transport http {
					dial_timeout 2s
					response_header_timeout 5s
				}
			}
			@confirmed {
				method POST
				header Origin https://cms.luminovia.org
				header Authorization "Bearer *"
				header Content-Type application/json
			}
			request_body @confirmed {
				max_size 24576
			}
			reverse_proxy @confirmed unix//srv/.platform-reset.sock {
				header_up -Cookie
				header_up -Referer
				transport http {
					dial_timeout 2s
					response_header_timeout 45m
				}
			}
			respond 403
		}
	}
}

# Dedicated installations may overlay these public assets while the signed
# package stays byte-exact and readable through the package query.
(academy_pwa_asset) {
	route {
		vars academy_pwa_static_fallback true
		header >Cache-Control "no-cache, no-store, must-revalidate"
		@academyPwaMaintenance file {
			root /srv
			try_files /maintenance.enabled
		}
		file_server @academyPwaMaintenance {
			root /srv/current
		}
		reverse_proxy {$PORTAL_API_UPSTREAM:api:8000} {
			rewrite {args[0]}
			header_up -Cookie
			header_up -Authorization
			header_up -Referer
			header_up -If-None-Match
			header_up -If-Modified-Since
			@packageFallback status 404 429 5xx
			handle_response @packageFallback {
				file_server {
					root /srv/current
				}
			}
		}
	}
}

(academy_runtime_pwa) {
	@academyManifest {
		method GET HEAD
		path /manifest.webmanifest
		not query package=1
	}
	handle @academyManifest {
		import academy_pwa_asset /functions/v1/files?mode=academy-pwa-manifest
	}
	@academyAppleIcon {
		method GET HEAD
		path /icons/apple-touch-icon.png
		not query package=1
	}
	handle @academyAppleIcon {
		import academy_pwa_asset /functions/v1/files?mode=academy-pwa-image&variant=icon_512
	}
}

(academy_pwa_errors) {
	handle_errors 5xx {
		@academyPwaFallback vars academy_pwa_static_fallback true
		route @academyPwaFallback {
			header {
				Cache-Control "no-cache, no-store, must-revalidate"
				X-Content-Type-Options nosniff
			}
			file_server {
				root /srv/current
				status 200
			}
		}
	}
}

{$PORTAL_DOMAIN} {
	encode zstd gzip
	import {$PORTAL_CADDY_ERROR_PROFILE:portal_standard_errors}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Robots-Tag "noindex, nofollow"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://{$PORTAL_DOMAIN}; worker-src 'self'; frame-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
	}
	route {
		# Retired bookmarks must not fall through to the application shell.
		@retiredDemo path /demo /demo/*
		header @retiredDemo Cache-Control no-store
		respond @retiredDemo 404
		import {$PORTAL_CADDY_PWA_PROFILE:portal_static_pwa}
		import {$PORTAL_CADDY_RESET_PROFILE:portal_no_reset}
		# Apply no-store to private business responses; block Auth administration routes and check maintenance before proxying.
		handle_path /backend/* {
			route {
				header >Cache-Control "no-store, private"
				request_body {
					max_size 104873984
				}
				@authAdmin path /auth/v1/admin /auth/v1/admin/*
				respond @authAdmin 404
				@maintenance {
					file {
						root /srv
						try_files maintenance.enabled
					}
				}
				header @maintenance Retry-After "60"
				respond @maintenance "Kurze Wartung. Bitte gleich erneut versuchen. / Brief maintenance. Please try again shortly." 503
				@publicApi path /auth/v1/* /rest/v1/* /realtime/v1/* /storage/v1/* /functions/v1/*
				reverse_proxy @publicApi {$PORTAL_API_UPSTREAM:api:8000} {
					header_up -Referer
					transport http {
						dial_timeout 5s
						response_header_timeout 150s
					}
				}
				respond 404
			}
		}
		# Serve the public Auth templates from an explicit allowlist.
		handle_path /mail-templates/* {
			route {
				root * /mail-templates
				header Cache-Control no-store
				@templates path /invite.html /recovery.html /authenticator-enrolled.html /authenticator-unenrolled.html
				file_server @templates
				respond 404
			}
		}
		# Public hashed assets may be cached long term; private downloads must not use this route.
		handle /assets/* {
			route {
				root * /srv
				header >Cache-Control "public, max-age=31536000, immutable"
				file_server
			}
		}
		# Versioned public Workbox files use the same immutable cache policy.
		handle /workbox-*.js {
			route {
				root * /srv
				header >Cache-Control "public, max-age=31536000, immutable"
				file_server
			}
		}
		@academyDeliverables path /api/client.ts /api/client.py /api/workflows.json /api/browser-sbom.cdx.json /api/dependency-licenses.txt
		handle @academyDeliverables {
			root * /srv/current
			@clientSources path /api/client.ts /api/client.py
			header @clientSources Content-Type "text/plain; charset=utf-8"
			header X-Content-Type-Options nosniff
			header Cache-Control no-store
			file_server
		}
		# Preserve SPA deep links while keeping the app shell and service worker revalidatable for updates.
		handle {
			route {
				root * /srv/current
				@private path /.env* /.git/* /supabase/* /deploy/* /private/*
				respond @private 404
				try_files {path} /index.html
				@shell path /index.html /sw.js /registerSW.js /manifest.webmanifest
				header @shell Cache-Control "no-cache, no-store, must-revalidate"
				@hashed path /assets/*
				header @hashed Cache-Control "public, max-age=31536000, immutable"
				file_server
			}
		}
	}
}

# Legacy public entry points for the Luminovia instance.
(cms_legacy_aliases) {
	lms.luminovia.org, portal.luminovia.org {
		redir https://cms.luminovia.org{uri} 308
	}

	http://lms.luminovia.org, http://portal.luminovia.org {
		redir https://cms.luminovia.org{uri} 308
	}
}

(academy_no_aliases) {
	# A dedicated installation serves only its configured Academy domain.
}

import {$PORTAL_CADDY_ALIAS_PROFILE:academy_no_aliases}
