# SERVER ONLY. Copy outside www to a private root-owned 0600 file.
# Templates are disabled. Do not put credentials in Git or VITE_ variables.
PORTAL_NOTIFICATION_MAIL_ENABLED=false
PORTAL_NOTIFICATION_API_URL=http://127.0.0.1:8000
PORTAL_NOTIFICATION_APP_ORIGIN=https://cms.luminovia.org
PORTAL_NOTIFICATION_SERVICE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY
PORTAL_NOTIFICATION_SMTP_USERNAME=info@luminovia.org
PORTAL_NOTIFICATION_SMTP_PASSWORD=REPLACE_IN_PRIVATE_SERVER_FILE
# 465 = implicit verified TLS; 587 = mandatory verified STARTTLS.
PORTAL_NOTIFICATION_SMTP_PORT=465
PORTAL_NOTIFICATION_BATCH=10
PORTAL_NOTIFICATION_TIMEOUT_SECONDS=15
