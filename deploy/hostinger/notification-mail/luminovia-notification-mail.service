[Unit]
Description=Luminovia finite notification email outbox batch
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/luminovia-portal/private/selfhost.env.notification.env

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/luminovia-portal/source
EnvironmentFile=/opt/luminovia-portal/private/selfhost.env.notification.env
# The shared global lock prevents this DB writer from crossing the existing
# exclusive backup/update/restore boundary. A busy boundary skips this batch.
ExecStart=/usr/bin/flock --shared --nonblock --conflict-exit-code 0 /run/lock/luminovia-maintenance.lock /usr/bin/python3 /opt/luminovia-portal/source/deploy/hostinger/notification-mail/worker.py --run
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/run/lock

[Install]
WantedBy=multi-user.target
