# Parameter names and synthetic examples for private selfhosting only. Generate and store real passwords, signing keys and service values outside Git.
# Shape only: generate a new private file with generate-env.mjs. Never start with placeholders.
PORTAL_APP_ORIGIN="https://srv2163645.hstgr.cloud"
PORTAL_MAIL_TEMPLATE_ORIGIN="https://srv2163645.hstgr.cloud"
PORTAL_BACKEND_NETWORK="luminovia-portal-backend"
PORTAL_DATA_DIR="/opt/luminovia/data"
PORTAL_INVITES_ENABLED="true"
# Server-to-server intake stays disabled until a trusted Website transport is approved.
# Never copy the integration token into Website source, VITE_ variables or a browser form.
PORTAL_WEBSITE_ENQUIRIES_ENABLED="false"
PORTAL_WEBSITE_ORIGIN=""
PORTAL_WEBSITE_PRIVACY_NOTICE_VERSION=""
PORTAL_WEBSITE_INTEGRATION_TOKEN=""
PORTAL_FUNCTIONS_MEMORY_LIMIT="1280m"
SUPABASE_PUBLIC_URL="https://srv2163645.hstgr.cloud/backend"
API_EXTERNAL_URL="https://srv2163645.hstgr.cloud/backend/auth/v1"
SITE_URL="https://srv2163645.hstgr.cloud"
ADDITIONAL_REDIRECT_URLS="https://srv2163645.hstgr.cloud/auth/callback,https://srv2163645.hstgr.cloud/auth/password"
POSTGRES_HOST="db"
POSTGRES_PORT="5432"
POSTGRES_DB="postgres"
POSTGRES_PASSWORD="GENERATE_PRIVATE_VALUE"
JWT_SECRET="GENERATE_PRIVATE_VALUE"
JWT_EXPIRY="3600"
ANON_KEY="GENERATE_PRIVATE_VALUE"
SERVICE_ROLE_KEY="GENERATE_PRIVATE_VALUE"
SUPABASE_PUBLISHABLE_KEY="GENERATE_PRIVATE_VALUE"
SUPABASE_SECRET_KEY="GENERATE_PRIVATE_VALUE"
ANON_KEY_ASYMMETRIC="GENERATE_PRIVATE_VALUE"
SERVICE_ROLE_KEY_ASYMMETRIC="GENERATE_PRIVATE_VALUE"
JWT_KEYS="GENERATE_PRIVATE_VALUE"
JWT_JWKS="GENERATE_PRIVATE_VALUE"
SECRET_KEY_BASE="GENERATE_PRIVATE_VALUE"
REALTIME_DB_ENC_KEY="GENERATE_PRIVATE_VALUE"
DASHBOARD_USERNAME="disabled"
DASHBOARD_PASSWORD="GENERATE_PRIVATE_VALUE"
PGRST_DB_SCHEMAS="public,graphql_public"
PGRST_DB_MAX_ROWS="1000"
PGRST_DB_EXTRA_SEARCH_PATH="public,extensions"
SMTP_ADMIN_EMAIL="no-reply@example.invalid"
SMTP_HOST="mailpit"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_SENDER_NAME="Luminovia Portal"
MAILER_URLPATHS_INVITE="/backend/auth/v1/verify"
