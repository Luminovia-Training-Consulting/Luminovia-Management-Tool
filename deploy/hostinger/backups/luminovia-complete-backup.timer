# Startet den täglichen verschlüsselten Backupversuch in UTC. Dieser lokale Timer ist kein Nachweis einer externen Aufbewahrung oder eines erfolgreichen Restoretests.
[Unit]
Description=Luminovia complete encrypted recovery backup every 24 hours

[Timer]
OnCalendar=*-*-* 02:00:00 UTC
AccuracySec=1min
Persistent=true
Unit=luminovia-complete-backup.service

[Install]
WantedBy=timers.target
